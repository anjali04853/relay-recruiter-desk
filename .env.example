# This is a reference file. Spring Boot does not load .env automatically.
# Set these as environment variables in the terminal running start.ps1.
PORT=8080
DB_PASSWORD=replace-with-local-db-password
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8080/auth/linkedin/callback
POST_PROVIDER_URL=
POST_PROVIDER_TOKEN=
LIVE_SEND=false
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_TLS_REQUIRED=true
